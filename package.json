{
  "name": "dsh-plugin-inkstone",
  "version": "0.1.0",
  "description": "端砚 (Inkstone): DeepSeek Harness plugin integrating the A2A agent registry — OpenXLab SSO sign-in, directory browsing, and remote A2A subagents",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-gateway"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsdown",
    "test": "vitest run"
  },
  "dependencies": {
    "@a2a-js/sdk": "~1.1.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.2.1-alpha.1",
    "@deepseek-ai/cordis-plugin-loader": ">=0.2.1-alpha.1",
    "@deepseek-ai/dsh-brand": ">=0.2.1-alpha.1",
    "@deepseek-ai/dsh-credentials": ">=0.2.1-alpha.1",
    "@deepseek-ai/dsh-llm": ">=0.2.1-alpha.1",
    "@deepseek-ai/dsh-session": ">=0.2.1-alpha.1",
    "@deepseek-ai/dsh-subagent": ">=0.2.1-alpha.1",
    "@deepseek-ai/dsh-tools": ">=0.2.1-alpha.1",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.1-alpha.1",
    "@deepseek-ai/schemastery": ">=0.2.1-alpha.1",
    "@deepseek-ai/dsh-mcp-client": ">=0.2.1-alpha.1",
    "@deepseek-ai/dsh-skill": ">=0.2.1-alpha.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/react": "~18.3.1",
    "jsdom": "^25.0.1",
    "lightningcss": "^1.33.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.0",
    "vite": "^6.4.4",
    "vitest": "^4.1.8"
  }
}
